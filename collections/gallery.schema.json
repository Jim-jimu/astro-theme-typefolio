{
  "$ref": "#/definitions/gallery",
  "definitions": {
    "gallery": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 60
        },
        "description": {
          "type": "string"
        },
        "draft": {
          "type": "boolean",
          "default": false
        },
        "publishDate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "integer",
                  "format": "unix-time"
                }
              ]
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "$ref": "#/definitions/gallery/properties/title"
              },
              "src": {
                "type": "string"
              },
              "caption": {
                "type": "string"
              },
              "descPosition": {
                "type": "string",
                "enum": [
                  "top",
                  "right",
                  "bottom",
                  "left"
                ],
                "default": "bottom"
              }
            },
            "required": [
              "src"
            ],
            "additionalProperties": false
          }
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "publishDate",
        "images"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}